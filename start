#!/usr/bin/env bash
set -euo pipefail

# Cross-platform start script (Unix bash section)
# - Prompts for ports
# - Writes .env in project root
# - Starts Docker Compose

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${PROJECT_ROOT}/.env"

# Defaults
DEFAULT_SPRING_PORT=8081
DEFAULT_MYSQL_PORT=3306
DEFAULT_PHPMYADMIN_PORT=8082

read_port() {
  local prompt="$1"
  local default="$2"
  local var
  while true; do
    read -r -p "${prompt} [default: ${default}]: " var || true
    var=${var:-$default}
    if [[ "$var" =~ ^[0-9]{2,5}$ ]]; then
      echo "$var"
      return 0
    else
      echo "Invalid port: '$var'. Please enter a numeric port (e.g., 8080)." >&2
    fi
  done
}

echo "Configure ports for the stack:"
SPRING_PORT=$(read_port "Enter Spring Boot (app) host port" "$DEFAULT_SPRING_PORT")
MYSQL_PORT=$(read_port "Enter MySQL host port" "$DEFAULT_MYSQL_PORT")
PHPMYADMIN_PORT=$(read_port "Enter phpMyAdmin host port" "$DEFAULT_PHPMYADMIN_PORT")

# Fixed DB config
MYSQL_ROOT_PASSWORD="root"
MYSQL_DATABASE="mydb"
SPRING_DATASOURCE_URL="jdbc:mysql://mysql:3306/${MYSQL_DATABASE}"
SPRING_DATASOURCE_USERNAME="root"
SPRING_DATASOURCE_PASSWORD="${MYSQL_ROOT_PASSWORD}"

cat > "$ENV_FILE" <<EOF
# Generated by start script on $(date -Iseconds)

# MySQL
MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=$MYSQL_DATABASE
MYSQL_PORT=$MYSQL_PORT

# Spring Boot datasource
SPRING_DATASOURCE_URL=$SPRING_DATASOURCE_URL
SPRING_DATASOURCE_USERNAME=$SPRING_DATASOURCE_USERNAME
SPRING_DATASOURCE_PASSWORD=$SPRING_DATASOURCE_PASSWORD

# Ports
SPRING_SERVER_PORT=$SPRING_PORT
PHPMYADMIN_PORT=$PHPMYADMIN_PORT
EOF

echo "Wrote environment file: $ENV_FILE"

# Detect docker compose command
compose_cmd="docker-compose"
if ! command -v docker-compose >/dev/null 2>&1; then
  if command -v docker >/dev/null 2>&1; then
    compose_cmd="docker compose"
  else
    echo "Error: docker is not installed or not in PATH." >&2
    exit 127
  fi
fi

cd "$PROJECT_ROOT"
echo "Starting Docker Compose build and up..."
$compose_cmd up --build
exit $?

# shellcheck disable=SC2317
@echo off
# shellcheck disable=SC2317
REM ================= Windows Cmd section =================
# shellcheck disable=SC2317
setlocal enabledelayedexpansion

# shellcheck disable=SC2317
# shellcheck disable=SC1036
REM Cross-platform start script (Windows Cmd section)
REM - Prompts for ports
REM - Writes .env in project root
REM - Starts Docker Compose

REM Resolve project root and .env path
set PROJECT_ROOT=%~dp0
set ENV_FILE=%PROJECT_ROOT%.env

REM Defaults
set DEFAULT_SPRING_PORT=8081
set DEFAULT_MYSQL_PORT=3306
set DEFAULT_PHPMYADMIN_PORT=8082

REM Read port with validation (2-5 digits)
:read_port
REM %1=prompt, %2=default, returns in PORT_OUT
set PROMPT=%~1
set DEFAULT=%~2
:read_loop
set /p INPUT=%PROMPT% [default: %DEFAULT%]:
if "%INPUT%"=="" set INPUT=%DEFAULT%
for /f "tokens=1" %%A in ("%INPUT%") do set VAL=%%A
for /f "tokens=1 delims=0123456789" %%B in ("%VAL%") do set NONNUM=%%B
if "%NONNUM%"=="" (
  if not "%VAL%"=="" (
    set PORT_OUT=%VAL%
    goto :read_done
  )
)
echo Invalid port: '%INPUT%'. Please enter a numeric port (e.g., 8080).
goto :read_loop
:read_done

REM Ask ports
call :read_port "Enter Spring Boot (app) host port" %DEFAULT_SPRING_PORT%
set SPRING_PORT=%PORT_OUT%
call :read_port "Enter MySQL host port" %DEFAULT_MYSQL_PORT%
set MYSQL_PORT=%PORT_OUT%
call :read_port "Enter phpMyAdmin host port" %DEFAULT_PHPMYADMIN_PORT%
set PHPMYADMIN_PORT=%PORT_OUT%

REM Fixed DB config
set MYSQL_ROOT_PASSWORD=root
set MYSQL_DATABASE=mydb
set SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/%MYSQL_DATABASE%
set SPRING_DATASOURCE_USERNAME=root
set SPRING_DATASOURCE_PASSWORD=%MYSQL_ROOT_PASSWORD%

REM Write .env
>"%ENV_FILE%" echo # Generated by start script on %DATE% %TIME%
>>"%ENV_FILE%" echo.
>>"%ENV_FILE%" echo # MySQL
>>"%ENV_FILE%" echo MYSQL_ROOT_PASSWORD=%MYSQL_ROOT_PASSWORD%
>>"%ENV_FILE%" echo MYSQL_DATABASE=%MYSQL_DATABASE%
>>"%ENV_FILE%" echo MYSQL_PORT=%MYSQL_PORT%
>>"%ENV_FILE%" echo.
>>"%ENV_FILE%" echo # Spring Boot datasource
>>"%ENV_FILE%" echo SPRING_DATASOURCE_URL=%SPRING_DATASOURCE_URL%
>>"%ENV_FILE%" echo SPRING_DATASOURCE_USERNAME=%SPRING_DATASOURCE_USERNAME%
>>"%ENV_FILE%" echo SPRING_DATASOURCE_PASSWORD=%SPRING_DATASOURCE_PASSWORD%
>>"%ENV_FILE%" echo.
>>"%ENV_FILE%" echo # Ports
>>"%ENV_FILE%" echo SPRING_SERVER_PORT=%SPRING_PORT%
>>"%ENV_FILE%" echo PHPMYADMIN_PORT=%PHPMYADMIN_PORT%

echo Wrote environment file: %ENV_FILE%

REM Detect docker compose command
where docker-compose >nul 2>nul
if %ERRORLEVEL%==0 (
  set COMPOSE_CMD=docker-compose
) else (
  where docker >nul 2>nul
  if not %ERRORLEVEL%==0 (
    echo Error: docker is not installed or not in PATH.
    exit /b 127
  )
  set COMPOSE_CMD=docker compose
)

cd "%PROJECT_ROOT%"
echo Starting Docker Compose build and up...
%COMPOSE_CMD% up --build
exit /b %ERRORLEVEL%
