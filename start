#!/usr/bin/env bash
set -euo pipefail

# Cross-platform start script (Unix bash section)
# - Prompts for ports
# - Writes .env in project root
# - Starts Docker Compose

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${PROJECT_ROOT}/.env"

# Defaults
DEFAULT_SPRING_PORT=8080
DEFAULT_MYSQL_PORT=3306
DEFAULT_PHPMYADMIN_PORT=8082
DEFAULT_FRONTEND_PORT=3000

read_port_once() {
  local prompt="$1"
  local default="$2"
  local var
  read -r -p "${prompt} [default: ${default}]: " var || true
  var=${var:-$default}
  if [[ "$var" =~ ^[0-9]+$ ]]; then
    echo "$var"
  else
    echo "Invalid port: '$var'. Using default: $default." >&2
    echo "$default"
  fi
}

echo "Configure ports for the stack:"
FRONTEND_PORT=$(read_port_once "Enter Frontend (app) host port" "$DEFAULT_FRONTEND_PORT")
SPRING_PORT=$(read_port_once "Enter Spring Boot (app) host port" "$DEFAULT_SPRING_PORT")
PHPMYADMIN_PORT="$DEFAULT_PHPMYADMIN_PORT"

# Fixed DB config
MYSQL_ROOT_PASSWORD="root"
MYSQL_DATABASE="mydb"
SPRING_DATASOURCE_URL="jdbc:mysql://mysql:3306/${MYSQL_DATABASE}"
SPRING_DATASOURCE_USERNAME="root"
SPRING_DATASOURCE_PASSWORD="${MYSQL_ROOT_PASSWORD}"

cat > "$ENV_FILE" <<EOF
# Generated by start script on $(date -Iseconds)

# MySQL
MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=$MYSQL_DATABASE
MYSQL_PORT=$DEFAULT_MYSQL_PORT

# Spring Boot datasource
SPRING_DATASOURCE_URL=$SPRING_DATASOURCE_URL
SPRING_DATASOURCE_USERNAME=$SPRING_DATASOURCE_USERNAME
SPRING_DATASOURCE_PASSWORD=$SPRING_DATASOURCE_PASSWORD

# Ports
FRONTEND_PORT=$FRONTEND_PORT
SPRING_SERVER_PORT=$SPRING_PORT
PHPMYADMIN_PORT=$PHPMYADMIN_PORT

NEXT_PUBLIC_API_URL=http://localhost
EOF

echo "Wrote environment file: $ENV_FILE"

# Detect docker compose command
compose_cmd="docker-compose"
if ! command -v docker-compose >/dev/null 2>&1; then
  if command -v docker >/dev/null 2>&1; then
    compose_cmd="docker compose"
  else
    echo "Error: docker is not installed or not in PATH." >&2
    exit 127
  fi
fi

cd "$PROJECT_ROOT"
echo "Starting Docker Compose build and up..."
if [[ "${SKIP_COMPOSE:-}" == "1" ]]; then
  exit 0
fi
$compose_cmd up --build
exit $?
